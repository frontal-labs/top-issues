{
  "name": "@frontal-labs/top-issues",
  "version": "0.0.1",
  "private": true,
  "description": "Frontal tool that surfaces top GitHub issues sorted by +1 reactions for automated community reporting",
  "keywords": [
    "github",
    "issues",
    "analytics",
    "slack",
    "reactions"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "top-issues": "./src/cli.ts"
  },
  "scripts": {
    "changeset": "changeset",
    "generate": "bun src/cli.ts",
    "lint": "biome ci .",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "@t3-oss/env-core": "^0.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.6.3",
    "ultracite": "^8.1.0"
  }
}
