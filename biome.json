{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": true,
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.json",
      "*.jsonc",
      "*.md",
      "*.ts",
      "*.tsx",
      ".github/**",
      "!dist",
      "!node_modules"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/cli.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
